{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% form_theme redirectForm '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block content %}
    {{ form_start(redirectForm) }}

    <div class="card">
        <h3 class="card-header">{{ layoutTitle }}</h3>

        <div class="card-body">
            <div class="form-wrapper">
                {{ form_widget(redirectForm) }}
            </div>
        </div>

        <div class="card-footer">
            <a href="{{ path('admin_redirect_index') }}" class="btn btn-outline-secondary">
                {{ 'Cancel'|trans({}, 'Admin.Actions') }}
            </a>
            <button class="btn btn-primary float-right" id="save-button">
                {{ 'Save'|trans({}, 'Admin.Actions') }}
            </button>
        </div>
    </div>

    {{ form_end(redirectForm) }}
{% endblock %}
